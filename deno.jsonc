{
  "tasks": {
    "test": "deno test --env-file --allow-env --allow-read --allow-net",
    "test:watch": "deno test --env-file --allow-env --allow-read --allow-net --watch",
    "check": "deno check src/**/*.ts tests/**/*.ts",
    "fmt": "deno fmt",
    "lint": "deno lint"
  },
  "test": {
    "include": ["tests/**/*.test.ts"]
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 80,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "proseWrap": "always"
  },
  "lint": {
    "rules": {
      "exclude": ["no-explicit-any"]
    }
  },
  "imports": {
    "effect": "npm:effect@3.18.4",
    "@effect/platform": "npm:@effect/platform@0.92.1",
    "@effect/platform-node": "npm:@effect/platform-node@0.98.4",
    "@std/assert": "jsr:@std/assert@^1"
  }
}
